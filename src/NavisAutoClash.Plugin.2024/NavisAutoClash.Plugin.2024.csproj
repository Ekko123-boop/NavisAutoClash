<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <RootNamespace>NavisAutoClash.Plugin</RootNamespace>
    <AssemblyName>NavisAutoClashPlugin2024</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <!-- Copy all dependency DLLs to output so they land next to the plugin DLL -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <NavisworksPath Condition="'$(NavisworksPath)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2024</NavisworksPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NavisAutoClash.Core\NavisAutoClash.Core.csproj" />
    <ProjectReference Include="..\NavisAutoClash.Infrastructure\NavisAutoClash.Infrastructure.csproj" />
    <ProjectReference Include="..\NavisAutoClash.UI\NavisAutoClash.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=False: these DLLs are already in the Navisworks installation dir -->
    <Reference Include="Autodesk.Navisworks.Api" Condition="Exists('$(NavisworksPath)\Autodesk.Navisworks.Api.dll')">
      <HintPath>$(NavisworksPath)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Clash" Condition="Exists('$(NavisworksPath)\Autodesk.Navisworks.Clash.dll')">
      <HintPath>$(NavisworksPath)\Autodesk.Navisworks.Clash.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
